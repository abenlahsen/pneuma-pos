# =============================================================
# Deploy environment variables — KEEP THIS FILE SECRET
# Copy deploy.env.example to deploy.env and fill in your values.
# =============================================================

VPS_HOST=""
VPS_USER="root"
VPS_PORT=22

DB_HOST="localhost"
DB_DATABASE=""
DB_USERNAME=""
DB_PASSWORD=""

APP_DIR="/var/www/quel-pneu.ma"
DOMAIN=""
DOMAIN_WWW=""

# Set to "sudo" if VPS_USER is not root; leave empty if VPS_USER is root.
VPS_SUDO="sudo"

# SSH host-key verification mode. Default: accept-new (TOFU on first deploy).
# Hardening (recommended after the first successful deploy):
#   ssh-keyscan -p $VPS_PORT $VPS_HOST >> ~/.ssh/known_hosts
#   SSH_STRICT_HOST_KEY_CHECKING=yes
# Then remote host-key changes will abort the deploy instead of silently trusting.
SSH_STRICT_HOST_KEY_CHECKING="accept-new"
