# =============================================================
# Deploy environment variables (secondary VPS) — KEEP SECRET
# Copy deploy2.env.example to deploy2.env and fill in your values.
# =============================================================

VPS_HOST=""
VPS_USER="root"
VPS_PORT=22

DB_HOST="localhost"
DB_DATABASE=""
DB_USERNAME=""
DB_PASSWORD=""

APP_DIR="/var/www/my-other-site"
APP_URL="https://my-other-site.example"
APP_NAME="My Other POS"

# Owner applied recursively to $APP_DIR at the end of each deploy.
# Adjust to match the user your web server runs as
# (e.g. www-data:www-data on Debian/Ubuntu, nginx:nginx on RHEL, apache:apache on CentOS).
WWW_OWNER="www-data:www-data"

# Set to "sudo" if VPS_USER is not root; leave empty if VPS_USER is root.
VPS_SUDO="sudo"

# SSH host-key verification mode. Default: accept-new (TOFU on first deploy).
# Hardening (recommended after the first successful deploy):
#   ssh-keyscan -p $VPS_PORT $VPS_HOST >> ~/.ssh/known_hosts
#   SSH_STRICT_HOST_KEY_CHECKING=yes
SSH_STRICT_HOST_KEY_CHECKING="accept-new"
